# Copier en .env (jamais versionne) :  cp .env.exemple .env
# Puis remplacer chaque "a_changer" par un vrai mot de passe.
# Mots de passe : lettres, chiffres et tirets uniquement. Pas d'accents dans ce fichier.
GROUPE=3
NB_APP=2
# Extensions actives, separees par des virgules : e1 (lb2+VRRP), e2 (supervision)
EXTENSIONS=
# Base de donnees (lus par scripts/bdd.sh, replique.sh et app.sh)
PG_DB=resultats
PG_APP_USER=app_user
PG_APP_PASSWORD=a_changer
PG_REPL_USER=repl_user
PG_REPL_PASSWORD=a_changer
# 8 caracteres maximum (limite de keepalived)
VRRP_PASSWORD=a_changer
GRAFANA_PASSWORD=a_changer
